# NVIDIA NIM / Build API
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=z-ai/glm-5.3
NVIDIA_NIM_FAST_MODEL=z-ai/glm-5.3-flash

# Conservative defaults for free endpoints.
NVIDIA_NIM_MAX_CONCURRENCY=2
NVIDIA_NIM_RPM=20
NVIDIA_NIM_MAX_RETRIES=6
NVIDIA_NIM_TIMEOUT_SECONDS=180

# Groq speech-to-text
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_LANGUAGE=ja
GROQ_WHISPER_RPM=15
GROQ_WHISPER_MAX_RETRIES=6
GROQ_WHISPER_TIMEOUT_SECONDS=300
GROQ_AUDIO_CHUNK_SECONDS=900
